# --- Claude Code CLI auth (only needed for the GENERATE step) ---
# Create with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# --- X / Twitter API, OAuth 1.0a user context (only needed for the PUBLISH step) ---
# From https://developer.x.com  -> your app -> Keys and tokens
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Behavior ---
# true  = publish auto-posts the day's draft even if you didn't manually approve it
# false = publish only posts drafts you set to "approved" in drafts/<date>.json
AUTO_APPROVE=true

# Optional: pin a specific model for the Claude CLI (else uses the CLI default)
# CLAUDE_MODEL=
